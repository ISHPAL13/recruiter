# API Keys Configuration
# Copy this file to .env and fill in your actual API keys

# Required: Google Gemini API Key for AI responses
# Get it from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Aoede

# Required: Deepgram API Key for Speech-to-Text
# Get it from: https://console.deepgram.com/
# Free tier: 45,000 minutes/year
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Required for avatar mode: LiveAvatar API Key
LIVEAVATAR_API_KEY=your_liveavatar_api_key_here

# Required for avatar mode: LiveAvatar avatar ID
LIVEAVATAR_AVATAR_ID=your_liveavatar_avatar_id_here

# Optional: LiveAvatar context ID / persona context
LIVEAVATAR_CONTEXT_ID=

# Optional: Default language for avatar speech
LIVEAVATAR_LANGUAGE=en

# Optional: Default voice ID, or tone-specific voice IDs below
LIVEAVATAR_DEFAULT_VOICE_ID=
LIVEAVATAR_VOICE_ID_PROFESSIONAL=
LIVEAVATAR_VOICE_ID_FRIENDLY=
LIVEAVATAR_VOICE_ID_STRICT=
LIVEAVATAR_VOICE_ID_CASUAL=

# Optional: Flask Secret Key (change in production)
SECRET_KEY=your-secret-key-change-in-production
